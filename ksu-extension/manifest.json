{
  "manifest_version": 3,
  "name": "KSU Schedule Extractor",
  "version": "1.0",
  "description": "استخراج بيانات الشعب من موقع جامعة الملك سعود",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://edugate.ksu.edu.sa/*",
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}